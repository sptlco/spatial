<!doctype html>
<html>
  <head>
    ${templates.meta} 
    ${templates.styles}
  </head>
  <body style="background: #0a0a0a">
    ${templates.preview}
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background: #0a0a0a; color: #ffffff">
      <tr>
        <td align="center" style="padding: 40px 20px">
          ${templates.header}
          <table border="0" cellpadding="0" cellspacing="0" width="100%;" style="color: #ffffff; max-width: 480px;">
            <tr>
              <td align="center" style="padding: 0 0 40px 0;">
                <h1 style="margin: 0 0 12px 0; font-size: 28px; font-weight: 700; line-height: 1.3;">
                  ${parameters.title}
                </h1>
                <p style="margin: 0; max-width: 384px; font-size: 16px; line-height: 1.1; color: rgba(255,255,255,0.5);">
                  ${parameters.timestamp}
                </p>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 0 0 40px 0;">
                <table border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="center">
                      <p style="margin: 0; font-size: 16px; color: #ffffff;">
                        <span style="color: rgba(255, 255, 255, 0.3); font-size: 14px;">Metric</span>
                        <br/>
                        <span>${parameters.metric}</span>
                      </p>
                      <br/>
                      <p style="margin: 0; font-size: 16px; color: #ffffff;">
                        <span style="color: rgba(255, 255, 255, 0.3); font-size: 14px;">Condition</span>
                        <br/>
                        <span>${parameters.condition}</span>
                      </p>
                      <br/>
                      <p style="margin: 0; font-size: 16px; color: #ffffff;">
                        <span style="color: rgba(255, 255, 255, 0.3); font-size: 14px;">Threshold</span>
                        <br/>
                        <span>${parameters.threshold}</span>
                      </p>
                      <br/>
                      <p style="margin: 0; font-size: 16px; color: #ffffff;">
                        <span style="color: rgba(255, 255, 255, 0.3); font-size: 14px;">Value</span>
                        <br/>
                        <span>${parameters.value}</span>
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 0 0 40px 0;">
                <p style="margin: 0; max-width: 384px; font-size: 12px; line-height: 1.5; color: rgba(255,255,255,0.3);">
                  This is an automated alert from the system.
                  <br/>
                  Do not reply to this email.
                </p>
              </td>
            </tr>
          </table>
          ${templates.footer}
        </td>
      </tr>
    </table>
  </body>
</html>
